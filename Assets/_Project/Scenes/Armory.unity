  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 483143}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0890a0171c09a7946886b2ea4087e833, type: 3}
  m_Name: 
  m_EditorClassIdentifier: FPS.Gameplay::FPS.Gameplay.DeploymentStation
  operations:
  - title: Tactical Raid
    scene: Mode_Raid
    briefing: One life. Download the intel at both terminals in the warehouse and the compound; every terminal you finish alerts the garrison. Then hold the extraction zone until the helicopter arrives.
    preview: {fileID: 2800000, guid: 6aa77e5b175da4342b27ad63ce0f6d55, type: 3}
  - title: Search & Destroy
    scene: Mode_SearchAndDestroy
    briefing: Rounds, no respawns. Attackers plant the charge at a site; defenders stop them or defuse it. Sides swap at half time.
    preview: {fileID: 2800000, guid: 469b3d9dcd8972d49a6c31ade38d8505, type: 3}
  - title: Hardpoint
    scene: Mode_Hardpoint
    briefing: Respawns. Hold the active zone with nobody else in it to score; the zone moves every minute.
    preview: {fileID: 2800000, guid: 50ca24aad6b14df4788e2ba95c2b4227, type: 3}
  - title: Locomotion Test Range
    scene: LocomotionTestRange
    briefing: No objectives. Ramps, ice, ledges and tunnels, the traversal course, targets out to 200 m, the shoot house and Squad Alpha's firefight yard.
    preview: {fileID: 2800000, guid: fd1af9383d2c45e47b5d20b6aa4fa3e7, type: 3}
  stationCamera: {fileID: 1561610242}
  hologram: {fileID: 2001786767}
  prompt: Open the deployment table
